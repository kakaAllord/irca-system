{
  "name": "@irca/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./registration": {
      "types": "./dist/registration/index.d.ts",
      "import": "./dist/registration/index.js",
      "require": "./dist/registration/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "libphonenumber-js": "^1.13.13"
  }
}
