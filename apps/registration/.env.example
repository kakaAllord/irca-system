# Copy to .env.local and adjust for your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irca_registration

# In production this is the only variable you need, and on Vercel the Neon
# integration sets it for you — there is nothing to paste.
#
# Prefer sslmode=verify-full over the sslmode=require Neon hands you.
# node-postgres currently treats `require` as an alias for `verify-full` and
# warns about it; in pg 9 it will mean "encrypt but do not verify the
# certificate", so pinning verify-full keeps today's behaviour instead of
# quietly weakening on a future npm update.
#
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
#
# DATABASE_URL_UNPOOLED is optional. The Neon integration sets it too, and
# db:migrate uses it when present so a build-time task does not take a pooler
# slot; nothing breaks without it.
