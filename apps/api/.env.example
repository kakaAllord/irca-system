# Copy to .env and adjust. Every variable is required unless it has a default
# in src/config/env.ts; the API refuses to start and names what is missing.
NODE_ENV=development
PORT=4000

# Everything the API does: the irca_app role.
DATABASE_URL=postgresql://irca_app:app_local_pw@localhost:5432/irca_dev
# Feature code while viewing as someone: the irca_readonly role, which can only read.
DATABASE_URL_READONLY=postgresql://irca_readonly:ro_local_pw@localhost:5432/irca_dev
# Migrations only: the irca_owner role. On Neon, the direct (non-pooler) host.
DIRECT_DATABASE_URL=postgresql://irca_owner:owner_local_pw@localhost:5432/irca_dev

# Where the portal lives: links in emails, and the Origin check on writes.
PORTAL_ORIGIN=http://localhost:3000

SESSION_COOKIE_NAME=irca_session        # production: __Host-irca_session
SESSION_ABSOLUTE_HOURS=168              # sign in again after 7 days, however active
SESSION_IDLE_HOURS=12                   # or after 12 hours unused
TRUST_PROXY=1                           # proxies in front of the API (portal rewrite, host load balancer)
LOG_LEVEL=debug
# How many recent log lines the dev console's Logs page can read back. In
# memory only: empty after a restart, and never written to the database.
LOG_BUFFER_LINES=2000

# Where the registration form lives, for the links the office sends people.
REGISTRATION_ORIGIN=http://localhost:3001

# Seals the Beem key and secret, which Communications types into Comms →
# Settings and which live only in the database (D26). 32 bytes, base64. Make
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it a Beem account cannot be saved and messages are only written to
# this log. Changing it makes a saved Beem account unreadable: save it again.
BEEM_SETTINGS_KEY=
# Whether texts really go to Beem once Communications saves an account.
# Production sends unless this is false; everywhere else only when it is true,
# so a machine with a Beem key typed in for a test still texts nobody.
SMS_LIVE=
# The password in the reply URL given to Beem (see docs/deployment.md), at
# least 24 characters. Without it, replies from Beem are refused.
BEEM_INBOUND_SECRET=

# Where files are kept (D24): a folder on a disk that outlives deploys. In
# production, the Railway volume's mount path on the API, such as /data/files
# (docs/deployment.md, "File storage"). Unset, uploads such as Outreach's
# session reports are refused with a message saying storage is not set up,
# and everything else works. Locally, any absolute path outside the repository.
FILES_DIR=
