// The IRCA system's database. Tables and columns are snake_case in SQL (via
// @map / @@map) so plain SQL and the dev console read naturally; models and
// fields are camelCase in TypeScript. Ids are UUID v7: sortable by creation
// time, and not guessable.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // The API compiles with module: nodenext, where relative imports must name
  // the emitted .js file.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ChurchStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  NONE
  DEV
}

enum UserStatus {
  INVITED // exists, has not set a password yet
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// A tenant. Everything a church owns points here.
model Church {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// Short uppercase code used in transaction numbers (IRCA-EXP-...). Frozen
  /// once the church has any finance entry (a trigger, Phase 4).
  code      String       @unique @db.VarChar(10)
  /// Lowercase, used in URLs and by API clients.
  slug      String       @unique @db.VarChar(40)
  name      String       @db.VarChar(120)
  timezone  String       @default("Africa/Dar_es_Salaam") @db.VarChar(64)
  currency  String       @default("TZS") @db.Char(3)
  status    ChurchStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    ChurchMembership[]
  modules        ChurchModule[]
  roles          Role[]
  placement      ChurchPlacement?
  sequences      ChurchSequence[]
  changeRequests ChangeRequest[]
  incomeSources  FinanceIncomeSource[]
  expenseItems   FinanceExpenseItem[]
  transactions   FinanceTransaction[]

  @@map("churches")
}

/// A person who can sign in. Global across churches.
model User {
  id                String       @id @default(uuid(7)) @db.Uuid
  /// Always stored trimmed and lowercased (normalizeEmail in @irca/shared).
  email             String       @unique @db.VarChar(254)
  fullName          String       @map("full_name") @db.VarChar(120)
  phone             String?      @db.VarChar(20)
  locale            String       @default("en") @db.VarChar(5)
  /// Null until the person accepts their invitation and sets a password.
  passwordHash      String?      @map("password_hash")
  passwordChangedAt DateTime?    @map("password_changed_at") @db.Timestamptz(6)
  platformRole      PlatformRole @default(NONE) @map("platform_role")
  status            UserStatus   @default(INVITED)
  failedLoginCount  Int          @default(0) @map("failed_login_count")
  lockedUntil       DateTime?    @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships ChurchMembership[]
  sessions    Session[]
  resetTokens PasswordResetToken[]

  @@map("users")
}

/// A user's place in one church. Roles hang off this, not off the user, so one
/// person can hold different roles in two churches.
model ChurchMembership {
  id          String           @id @default(uuid(7)) @db.Uuid
  churchId    String           @map("church_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      MembershipStatus @default(INVITED)
  invitedById String?          @map("invited_by_id") @db.Uuid
  joinedAt    DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  church      Church           @relation(fields: [churchId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  roles       MembershipRole[]
  invitations Invitation[]

  @@unique([churchId, userId])
  /// So a role can be linked only to a membership of the same church.
  @@unique([churchId, id])
  @@index([userId])
  @@map("church_memberships")
}

/// One signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id              String    @id @default(uuid(7)) @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  userId          String    @map("user_id") @db.Uuid
  /// The church this session is working in. Null for a dev who is not
  /// impersonating, and for a user with no active membership.
  activeChurchId  String?   @map("active_church_id") @db.Uuid
  /// Set while this session is impersonating someone. The foreign key to
  /// impersonation_sessions arrives in Phase 2; the column exists now so no
  /// session code has to change shape later.
  impersonationId String?   @unique @map("impersonation_id") @db.Uuid
  ip              String?   @db.VarChar(64)
  userAgent       String?   @map("user_agent") @db.VarChar(400)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason    String?   @map("revoke_reason") @db.VarChar(40)

  user          User                  @relation(fields: [userId], references: [id])
  impersonation ImpersonationSession? @relation(fields: [impersonationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

enum PermissionKindDb {
  READ
  WRITE
}

/// Mirror of the permissions defined in code, so roles can point at them with
/// a foreign key. Written only by the boot-time sync.
model Permission {
  key       String           @id @db.VarChar(80)
  moduleKey String           @map("module_key") @db.VarChar(40)
  kind      PermissionKindDb
  label     String           @db.VarChar(200)
  /// Set when the permission disappears from code. Retired permissions are
  /// ignored when resolving and never deleted, so old roles still load.
  retiredAt DateTime?        @map("retired_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Which modules a church has switched on. Turning one off keeps the row, its
/// roles and its data, so turning it back on restores everything.
model ChurchModule {
  churchId     String    @map("church_id") @db.Uuid
  moduleKey    String    @map("module_key") @db.VarChar(40)
  enabled      Boolean   @default(true)
  enabledAt    DateTime? @map("enabled_at") @db.Timestamptz(6)
  enabledById  String?   @map("enabled_by_id") @db.Uuid
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledById String?   @map("disabled_by_id") @db.Uuid

  church Church @relation(fields: [churchId], references: [id])

  @@id([churchId, moduleKey])
  @@map("church_modules")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  churchId    String    @map("church_id") @db.Uuid
  moduleKey   String    @map("module_key") @db.VarChar(40)
  name        String    @db.VarChar(80)
  description String    @default("") @db.VarChar(300)
  /// Set for roles created from a module's systemRoles. Their permissions are
  /// kept in step with code by the sync and cannot be edited in the portal.
  systemKey   String?   @map("system_key") @db.VarChar(80)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  church      Church           @relation(fields: [churchId], references: [id])
  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([churchId, moduleKey, name])
  @@unique([churchId, systemKey])
  /// Referenced by role_permissions and membership_roles together with the
  /// church, so a role of another church cannot be attached here.
  @@unique([churchId, id])
  @@map("roles")
}

model RolePermission {
  churchId      String @map("church_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(80)

  role       Role       @relation(fields: [churchId, roleId], references: [churchId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([churchId])
  @@map("role_permissions")
}

model MembershipRole {
  churchId     String   @map("church_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  grantedById  String?  @map("granted_by_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  membership ChurchMembership @relation(fields: [churchId, membershipId], references: [churchId, id], onDelete: Cascade)
  role       Role             @relation(fields: [churchId, roleId], references: [churchId, id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([churchId])
  @@index([roleId])
  @@map("membership_roles")
}

enum ImpersonationEndReason {
  STOPPED
  EXPIRED
  LOGOUT
  REVOKED
}

/// Every view-as: who, whom, where and when. No reason is asked for, and only
/// devs can read it (docs/plan/00-decisions.md, D16).
model ImpersonationSession {
  id               String                  @id @default(uuid(7)) @db.Uuid
  /// The actor's own session, the one doing the impersonating.
  sessionId        String                  @map("session_id") @db.Uuid
  actorUserId      String                  @map("actor_user_id") @db.Uuid
  subjectUserId    String                  @map("subject_user_id") @db.Uuid
  churchId         String                  @map("church_id") @db.Uuid
  /// The church the actor's session was in before, restored when it ends.
  previousChurchId String?                 @map("previous_church_id") @db.Uuid
  startedAt        DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt        DateTime                @map("expires_at") @db.Timestamptz(6)
  endedAt          DateTime?               @map("ended_at") @db.Timestamptz(6)
  endReason        ImpersonationEndReason? @map("end_reason")

  sessions Session[]

  @@index([churchId, startedAt(sort: Desc)])
  @@index([subjectUserId, startedAt(sort: Desc)])
  @@index([actorUserId, startedAt(sort: Desc)])
  @@map("impersonation_sessions")
}

/// Append-only. The app may insert and read, never update or delete.
model AuditEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  churchId        String?  @map("church_id") @db.Uuid
  /// 'core' for sign-ins and impersonation (platform plane), 'feature' for a
  /// church's own records (moves with the church, multi-tenancy.md section 13).
  source          String   @default("feature") @db.VarChar(10)
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  subjectUserId   String?  @map("subject_user_id") @db.Uuid
  impersonationId String?  @map("impersonation_id") @db.Uuid
  action          String   @db.VarChar(80)
  entityType      String?  @map("entity_type") @db.VarChar(60)
  entityId        String?  @map("entity_id") @db.VarChar(80)
  summary         String?  @db.VarChar(300)
  before          Json?
  after           Json?
  meta            Json?
  ip              String?  @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.VarChar(400)
  requestId       String?  @map("request_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([churchId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([subjectUserId, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Counters and gauges per church per local day.
model UsageDaily {
  churchId String   @map("church_id") @db.Uuid
  day      DateTime @db.Date
  metric   String   @db.VarChar(80)
  value    BigInt   @default(0)

  @@id([churchId, day, metric])
  @@index([day])
  @@map("usage_daily")
}

/// Counters with no church: failed sign-ins for unknown emails, dev console use.
model PlatformUsageDaily {
  day    DateTime @db.Date
  metric String   @db.VarChar(80)
  value  BigInt   @default(0)

  @@id([day, metric])
  @@map("platform_usage_daily")
}

/// Who was active on which day, for daily, weekly and monthly active people.
model UserActivityDaily {
  churchId String   @map("church_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @db.Date
  requests Int      @default(0)

  @@id([churchId, userId, day])
  @@index([churchId, day])
  @@map("user_activity_daily")
}

/// One row per background job run, or per church for a per-church job.
model JobRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  job        String    @db.VarChar(60)
  churchId   String?   @map("church_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  ok         Boolean?
  error      String?
  stats      Json?

  @@index([job, startedAt(sort: Desc)])
  @@map("job_runs")
}

enum PlacementState {
  ACTIVE
  /// Maintenance: writes are refused while the church's data is being moved.
  MOVING
}

/// Which database cluster holds a church's own records. One cluster today;
/// the column is what lets a large church move to its own database later.
model ChurchPlacement {
  churchId String         @id @map("church_id") @db.Uuid
  cluster  String         @default("shared") @db.VarChar(40)
  state    PlacementState @default(ACTIVE)
  movedAt  DateTime?      @map("moved_at") @db.Timestamptz(6)

  church Church @relation(fields: [churchId], references: [id])

  @@map("church_placements")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  /// Gave up after the last retry.
  FAILED
}

/// Emails are written here with the change that causes them, in one
/// transaction, and sent by a worker. A provider that is down delays an
/// invitation; it never loses one.
model EmailOutbox {
  id                String      @id @default(uuid(7)) @db.Uuid
  churchId          String?     @map("church_id") @db.Uuid
  toEmail           String      @map("to_email") @db.VarChar(254)
  template          String      @db.VarChar(60)
  /// What the template needs. One-time links are scrubbed once sent.
  payload           Json
  subject           String?     @db.VarChar(200)
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?     @map("last_error")
  providerMessageId String?     @map("provider_message_id") @db.VarChar(200)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([churchId, createdAt(sort: Desc)])
  @@map("email_outbox")
}

/// One invitation to one church. The person, their membership and their roles
/// are created when it is sent, so an administrator can adjust the roles
/// before it is accepted, and the People page can show who is still invited.
/// Roles do nothing until the membership becomes active.
model Invitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  churchId     String    @map("church_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  email        String    @db.VarChar(254)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById  String    @map("created_by_id") @db.Uuid
  sentCount    Int       @default(1) @map("sent_count")
  lastSentAt   DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  membership ChurchMembership @relation(fields: [churchId, membershipId], references: [churchId, id], onDelete: Cascade)

  @@index([churchId, createdAt(sort: Desc)])
  @@index([membershipId])
  @@map("invitations")
}

/// One-time password reset. Only the hash is stored, as with sessions.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Change requests (D17) and the Finance portal.
// ---------------------------------------------------------------------------

enum ChangeRequestStatus {
  PENDING
  APPROVED // decided yes, and applied in the same transaction
  REJECTED
  CANCELLED
}

/// A request, from anyone in any module, to change a record that may not be
/// changed directly. Decided in Admin -> Requests, never by the person who
/// asked. Nothing about finance is known here: the module registers a handler.
model ChangeRequest {
  id            String              @id @default(uuid(7)) @db.Uuid
  churchId      String              @map("church_id") @db.Uuid
  moduleKey     String              @map("module_key") @db.VarChar(40)
  entityType    String              @map("entity_type") @db.VarChar(60)
  entityId      String              @map("entity_id") @db.VarChar(80)
  entityLabel   String              @map("entity_label") @db.VarChar(120)
  action        String              @db.VarChar(20)
  /// The record as it was when asked, and only the values asked to change.
  before        Json
  proposed      Json
  reason        String              @db.VarChar(500)
  status        ChangeRequestStatus @default(PENDING)
  requestedById String              @map("requested_by_id") @db.Uuid
  requestedAt   DateTime            @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById   String?             @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?             @map("decision_note") @db.VarChar(500)
  appliedAt     DateTime?           @map("applied_at") @db.Timestamptz(6)
  /// What applying produced, e.g. { "newCode": "IRCA-EXP-2026-08-000003" }.
  result        Json?

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, status, requestedAt(sort: Desc)])
  @@index([churchId, entityType, entityId])
  @@map("change_requests")
}

/// Per-church counters, locked and incremented inside the transaction that
/// uses them. Finance uses 'finance:EXP:2026-09'; Phase 5 will use its own keys.
model ChurchSequence {
  churchId  String   @map("church_id") @db.Uuid
  key       String   @db.VarChar(80)
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@id([churchId, key])
  @@map("church_sequences")
}

enum FinanceKind {
  INCOME
  EXPENSE
}

enum FinanceStatus {
  POSTED
  VOIDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// What income is recorded against: Tithe, Sunday offering, Harambee.
model FinanceIncomeSource {
  id          String   @id @default(uuid(7)) @db.Uuid
  churchId    String   @map("church_id") @db.Uuid
  /// As shown, with the capitals the person typed.
  name        String   @db.VarChar(80)
  /// Normalised for matching and uniqueness: "sunday offering".
  nameKey     String   @map("name_key") @db.VarChar(80)
  description String   @default("") @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  church       Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([churchId, nameKey])
  @@unique([churchId, id])
  @@map("finance_income_sources")
}

/// What an expense is recorded against: Electricity bill, Generator fuel.
model FinanceExpenseItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  churchId    String   @map("church_id") @db.Uuid
  name        String   @db.VarChar(80)
  nameKey     String   @map("name_key") @db.VarChar(80)
  description String   @default("") @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  church       Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([churchId, nameKey])
  @@unique([churchId, id])
  @@map("finance_expense_items")
}

/// One entry in the books. Never deleted, and never changed except by an
/// approved change request: a trigger in the database says so as well.
model FinanceTransaction {
  id               String        @id @default(uuid(7)) @db.Uuid
  churchId         String        @map("church_id") @db.Uuid
  /// IRCA-EXP-2026-09-000001. Unique across every church.
  code             String        @unique @db.VarChar(40)
  kind             FinanceKind
  status           FinanceStatus @default(POSTED)
  txnDate          DateTime      @map("txn_date") @db.Date
  periodYear       Int           @map("period_year")
  periodMonth      Int           @map("period_month")
  seq              Int
  amount           Decimal       @db.Decimal(14, 2)
  currency         String        @db.Char(3)
  incomeSourceId   String?       @map("income_source_id") @db.Uuid
  expenseItemId    String?       @map("expense_item_id") @db.Uuid
  method           PaymentMethod
  /// Receipt number, M-Pesa code, cheque number.
  reference        String?       @db.VarChar(80)
  /// Who paid (income) or who was paid (expense).
  counterparty     String?       @db.VarChar(120)
  notes            String?       @db.VarChar(1000)
  /// Made by the form. A retried submit returns the first entry, not a second.
  clientRequestId  String        @map("client_request_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(6)
  /// The approver, not the person who asked.
  voidedById       String?       @map("voided_by_id") @db.Uuid
  voidReason       String?       @map("void_reason") @db.VarChar(500)
  /// Starts at 1, and goes up by one each time an approved change is applied.
  revision         Int           @default(1)
  /// The approved request that made the latest change. The trigger refuses any
  /// update that does not point at a newly approved, unapplied request.
  appliedRequestId String?       @map("applied_request_id") @db.Uuid
  /// An approved change that moves an entry to another month cannot renumber
  /// it, so the old entry is voided and this new one points back at it.
  replacesId       String?       @unique @map("replaces_id") @db.Uuid

  church       Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  incomeSource FinanceIncomeSource? @relation(fields: [churchId, incomeSourceId], references: [churchId, id])
  expenseItem  FinanceExpenseItem?  @relation(fields: [churchId, expenseItemId], references: [churchId, id])
  replaces     FinanceTransaction?  @relation("replacement", fields: [replacesId], references: [id])
  replacedBy   FinanceTransaction?  @relation("replacement")

  @@unique([churchId, kind, periodYear, periodMonth, seq])
  @@unique([churchId, clientRequestId])
  @@index([churchId, txnDate(sort: Desc)])
  @@index([churchId, kind, status, txnDate])
  @@index([churchId, incomeSourceId])
  @@index([churchId, expenseItemId])
  @@map("finance_transactions")
}
