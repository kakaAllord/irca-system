// The IRCA system's database. Tables and columns are snake_case in SQL (via
// @map / @@map) so plain SQL and the dev console read naturally; models and
// fields are camelCase in TypeScript. Ids are UUID v7: sortable by creation
// time, and not guessable.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // The API compiles with module: nodenext, where relative imports must name
  // the emitted .js file.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED // exists, has not set a password yet
  ACTIVE
  DISABLED
}

/// The church this system was deployed for. **Exactly one row, ever.**
///
/// Not a tenant: a second church gets its own deployment and its own database,
/// which is the whole reason nothing else in this schema carries a church id.
/// The row exists because the app genuinely needs these four facts — the code
/// that every entry number is built from, the name on the screen, the clock
/// dates are read in, and the currency money is shown in — and because the
/// office should be able to fix a typo in the name without a redeploy.
model Church {
  /// Always 1. A check constraint in the migration is what makes it a singleton.
  id        Int      @id @default(1)
  /// Short uppercase code used in entry numbers (IRCA-EXP-...). Frozen once
  /// there is any finance entry (a trigger, Phase 4).
  code      String   @db.VarChar(10)
  name      String   @db.VarChar(120)
  timezone  String   @default("Africa/Dar_es_Salaam") @db.VarChar(64)
  currency  String   @default("TZS") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("church")
}

/// A person who can sign in.
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Always stored trimmed and lowercased (normalizeEmail in @irca/shared).
  email             String     @unique @db.VarChar(254)
  fullName          String     @map("full_name") @db.VarChar(120)
  phone             String?    @db.VarChar(20)
  locale            String     @default("en") @db.VarChar(5)
  /// Null until the person accepts their invitation and sets a password.
  passwordHash      String?    @map("password_hash")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  status            UserStatus @default(INVITED)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// The person in People this account belongs to. Set when they are named a
  /// department's leader, which is what their leadership is looked up by (D28).
  personId          String?    @unique @map("person_id") @db.Uuid
  /// They turned off the church's text messages on their Account page.
  smsOptOut         Boolean    @default(false) @map("sms_opt_out")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  person      Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  roles       UserRole[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  invitations Invitation[]

  @@map("users")
}

/// One signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id              String    @id @default(uuid(7)) @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  userId          String    @map("user_id") @db.Uuid
  /// Set while this session is impersonating someone. The foreign key to
  /// impersonation_sessions arrives in Phase 2; the column exists now so no
  /// session code has to change shape later.
  impersonationId String?   @unique @map("impersonation_id") @db.Uuid
  ip              String?   @db.VarChar(64)
  userAgent       String?   @map("user_agent") @db.VarChar(400)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason    String?   @map("revoke_reason") @db.VarChar(40)

  user          User                  @relation(fields: [userId], references: [id])
  impersonation ImpersonationSession? @relation(fields: [impersonationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

enum PermissionKindDb {
  READ
  WRITE
}

/// Mirror of the permissions defined in code, so roles can point at them with
/// a foreign key. Written only by the boot-time sync.
model Permission {
  key       String           @id @db.VarChar(80)
  moduleKey String           @map("module_key") @db.VarChar(40)
  kind      PermissionKindDb
  label     String           @db.VarChar(200)
  /// Set when the permission disappears from code. Retired permissions are
  /// ignored when resolving and never deleted, so old roles still load.
  retiredAt DateTime?        @map("retired_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Which portals are switched on. Turning one off keeps the row, its roles and
/// its data, so turning it back on restores everything.
model ModuleState {
  moduleKey    String    @id @map("module_key") @db.VarChar(40)
  enabled      Boolean   @default(true)
  enabledAt    DateTime? @map("enabled_at") @db.Timestamptz(6)
  enabledById  String?   @map("enabled_by_id") @db.Uuid
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledById String?   @map("disabled_by_id") @db.Uuid

  @@map("module_state")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  moduleKey   String    @map("module_key") @db.VarChar(40)
  name        String    @db.VarChar(80)
  description String    @default("") @db.VarChar(300)
  /// Set for roles created from a module's systemRoles. Their permissions are
  /// kept in step with code by the sync and cannot be edited in the portal.
  systemKey   String?   @map("system_key") @db.VarChar(80)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  permissions RolePermission[]
  members     UserRole[]

  @@unique([moduleKey, name])
  @@unique([systemKey])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(80)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// A role granted to a person. Roles hang off the user now: with one church
/// there is no second set of roles for the same person to hold.
model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

enum ImpersonationEndReason {
  STOPPED
  EXPIRED
  LOGOUT
  REVOKED
}

/// Every view-as: who, whom, where and when. No reason is asked for, and only
/// devs can read it (docs/plan/00-decisions.md, D16).
model ImpersonationSession {
  id            String                  @id @default(uuid(7)) @db.Uuid
  /// The actor's own session, the one doing the impersonating.
  sessionId     String                  @map("session_id") @db.Uuid
  actorUserId   String                  @map("actor_user_id") @db.Uuid
  subjectUserId String                  @map("subject_user_id") @db.Uuid
  startedAt     DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt     DateTime                @map("expires_at") @db.Timestamptz(6)
  endedAt       DateTime?               @map("ended_at") @db.Timestamptz(6)
  endReason     ImpersonationEndReason? @map("end_reason")

  sessions Session[]

  @@index([startedAt(sort: Desc)])
  @@index([subjectUserId, startedAt(sort: Desc)])
  @@index([actorUserId, startedAt(sort: Desc)])
  @@map("impersonation_sessions")
}

/// Append-only. The app may insert and read, never update or delete.
model AuditEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// 'core' for sign-ins and impersonation (platform plane), 'feature' for a
  /// church's own records (moves with the church, multi-tenancy.md section 13).
  source          String   @default("feature") @db.VarChar(10)
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  subjectUserId   String?  @map("subject_user_id") @db.Uuid
  impersonationId String?  @map("impersonation_id") @db.Uuid
  action          String   @db.VarChar(80)
  entityType      String?  @map("entity_type") @db.VarChar(60)
  entityId        String?  @map("entity_id") @db.VarChar(80)
  summary         String?  @db.VarChar(300)
  before          Json?
  after           Json?
  meta            Json?
  ip              String?  @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.VarChar(400)
  requestId       String?  @map("request_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([subjectUserId, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Counters and gauges per church per local day.
model UsageDaily {
  day    DateTime @db.Date
  metric String   @db.VarChar(80)
  value  BigInt   @default(0)

  @@id([day, metric])
  @@index([day])
  @@map("usage_daily")
}

/// Who was active on which day, for daily, weekly and monthly active people.
model UserActivityDaily {
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @db.Date
  requests Int      @default(0)

  @@id([userId, day])
  @@index([day])
  @@map("user_activity_daily")
}

/// One row per background job run.
model JobRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  job        String    @db.VarChar(60)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  ok         Boolean?
  error      String?
  stats      Json?

  @@index([job, startedAt(sort: Desc)])
  @@map("job_runs")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  /// Gave up after the last retry.
  FAILED
}

/// Emails are written here with the change that causes them, in one
/// transaction, and sent by a worker. A provider that is down delays an
/// invitation; it never loses one.
model EmailOutbox {
  id                String      @id @default(uuid(7)) @db.Uuid
  toEmail           String      @map("to_email") @db.VarChar(254)
  template          String      @db.VarChar(60)
  /// What the template needs. One-time links are scrubbed once sent.
  payload           Json
  subject           String?     @db.VarChar(200)
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?     @map("last_error")
  providerMessageId String?     @map("provider_message_id") @db.VarChar(200)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([createdAt(sort: Desc)])
  @@map("email_outbox")
}

/// One invitation. The person and their roles are created when it is sent, so
/// an administrator can adjust the roles before it is accepted, and the People
/// page can show who is still invited. Roles do nothing until the account is
/// active.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  email       String    @db.VarChar(254)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById String    @map("created_by_id") @db.Uuid
  sentCount   Int       @default(1) @map("sent_count")
  lastSentAt  DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("invitations")
}

/// One-time password reset. Only the hash is stored, as with sessions.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A file kept in object storage (D24), for any module: Outreach's session
/// reports first, Finance's receipts later. The bytes live in the bucket; this
/// row says what they are, whose they are and who put them there. Replacing a
/// file sets `deleted_at` on the old row and keeps the object, so an earlier
/// version can still be found. Rows are never deleted by the application.
model File {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// The module that owns it, which decides who may read it: 'outreach'.
  moduleKey    String    @map("module_key") @db.VarChar(30)
  /// What it belongs to: 'outreach_session' and that session's id.
  entityType   String    @map("entity_type") @db.VarChar(40)
  entityId     String    @map("entity_id") @db.Uuid
  /// Where it is in the bucket: outreach/sessions/<session-id>/<uuid>.pdf.
  key          String    @unique @db.VarChar(300)
  originalName String    @map("original_name") @db.VarChar(200)
  contentType  String    @map("content_type") @db.VarChar(100)
  bytes        Int
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  /// Replaced by a newer version. The object is kept.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Change requests (D17) and the Finance portal.
// ---------------------------------------------------------------------------

enum ChangeRequestStatus {
  PENDING
  APPROVED // decided yes, and applied in the same transaction
  REJECTED
  CANCELLED
}

/// A request, from anyone in any module, to change a record that may not be
/// changed directly. Decided in Admin -> Requests, never by the person who
/// asked. Nothing about finance is known here: the module registers a handler.
model ChangeRequest {
  id            String              @id @default(uuid(7)) @db.Uuid
  moduleKey     String              @map("module_key") @db.VarChar(40)
  entityType    String              @map("entity_type") @db.VarChar(60)
  entityId      String              @map("entity_id") @db.VarChar(80)
  entityLabel   String              @map("entity_label") @db.VarChar(120)
  action        String              @db.VarChar(20)
  /// The record as it was when asked, and only the values asked to change.
  before        Json
  proposed      Json
  reason        String              @db.VarChar(500)
  status        ChangeRequestStatus @default(PENDING)
  requestedById String              @map("requested_by_id") @db.Uuid
  requestedAt   DateTime            @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById   String?             @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?             @map("decision_note") @db.VarChar(500)
  appliedAt     DateTime?           @map("applied_at") @db.Timestamptz(6)
  /// What applying produced, e.g. { "newCode": "IRCA-EXP-2026-08-000003" }.
  result        Json?

  @@index([status, requestedAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("change_requests")
}

/// Counters, locked and incremented inside the transaction that uses them.
/// Finance uses 'finance:EXP:2026-09'; Membership uses 'membership:member_number'.
model Sequence {
  key       String   @db.VarChar(80)
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([key])
  @@map("sequences")
}

enum FinanceKind {
  INCOME
  EXPENSE
}

enum FinanceStatus {
  POSTED
  VOIDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// What income is recorded against: Tithe, Sunday offering, Harambee.
model FinanceIncomeSource {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// As shown, with the capitals the person typed.
  name        String   @db.VarChar(80)
  /// Normalised for matching and uniqueness: "sunday offering".
  nameKey     String   @map("name_key") @db.VarChar(80)
  description String   @default("") @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions FinanceTransaction[]

  @@unique([nameKey])
  @@map("finance_income_sources")
}

/// What an expense is recorded against: Electricity bill, Generator fuel.
model FinanceExpenseItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(80)
  nameKey     String   @map("name_key") @db.VarChar(80)
  description String   @default("") @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions FinanceTransaction[]

  @@unique([nameKey])
  @@map("finance_expense_items")
}

/// One entry in the books. Never deleted, and never changed except by an
/// approved change request: a trigger in the database says so as well.
model FinanceTransaction {
  id               String        @id @default(uuid(7)) @db.Uuid
  /// IRCA-EXP-2026-09-000001, built from the church code in `church`.
  code             String        @unique @db.VarChar(40)
  kind             FinanceKind
  status           FinanceStatus @default(POSTED)
  txnDate          DateTime      @map("txn_date") @db.Date
  periodYear       Int           @map("period_year")
  periodMonth      Int           @map("period_month")
  seq              Int
  amount           Decimal       @db.Decimal(14, 2)
  currency         String        @db.Char(3)
  incomeSourceId   String?       @map("income_source_id") @db.Uuid
  expenseItemId    String?       @map("expense_item_id") @db.Uuid
  method           PaymentMethod
  /// Receipt number, M-Pesa code, cheque number.
  reference        String?       @db.VarChar(80)
  /// Who paid (income) or who was paid (expense).
  counterparty     String?       @db.VarChar(120)
  notes            String?       @db.VarChar(1000)
  /// Made by the form. A retried submit returns the first entry, not a second.
  clientRequestId  String        @map("client_request_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(6)
  /// The approver, not the person who asked.
  voidedById       String?       @map("voided_by_id") @db.Uuid
  voidReason       String?       @map("void_reason") @db.VarChar(500)
  /// Starts at 1, and goes up by one each time an approved change is applied.
  revision         Int           @default(1)
  /// The approved request that made the latest change. The trigger refuses any
  /// update that does not point at a newly approved, unapplied request.
  appliedRequestId String?       @map("applied_request_id") @db.Uuid
  /// An approved change that moves an entry to another month cannot renumber
  /// it, so the old entry is voided and this new one points back at it.
  replacesId       String?       @unique @map("replaces_id") @db.Uuid

  incomeSource FinanceIncomeSource? @relation(fields: [incomeSourceId], references: [id])
  expenseItem  FinanceExpenseItem?  @relation(fields: [expenseItemId], references: [id])
  replaces     FinanceTransaction?  @relation("replacement", fields: [replacesId], references: [id])
  replacedBy   FinanceTransaction?  @relation("replacement")

  @@unique([kind, periodYear, periodMonth, seq])
  @@unique([clientRequestId])
  @@index([txnDate(sort: Desc)])
  @@index([kind, status, txnDate])
  @@index([incomeSourceId])
  @@index([expenseItemId])
  @@map("finance_transactions")
}

// ---------------------------------------------------------------------------
// Registrations and the Membership portal (Phase 5).
// ---------------------------------------------------------------------------

/// The visitor's own answers, one row per registration.
///
/// One wide table, as the first database had it: the flow is fixed and ships
/// with the church, and the office asks plain questions of it ("how many
/// first-time visitors last Sunday", "who asked for baptism") without
/// pivoting. Column names are unchanged from that schema so the copy across
/// is one for one; only a uuid id and the old id are new.
model Registration {
  id           String  @id @default(uuid(7)) @db.Uuid
  /// The bigserial id from the first database, kept so a row can be traced.
  legacyId     BigInt? @map("legacy_id")
  token        String  @unique @db.VarChar(32)
  lang         String  @default("en") @db.VarChar(2)
  status       String  @default("in_progress") @db.VarChar(20)
  currentStep  String? @map("current_step")
  furthestStep String? @map("furthest_step")

  // how you heard
  heard          String[] @default([])
  heardOtherText String   @default("") @map("heard_other_text")
  friendName     String   @default("") @map("friend_name")

  // about you
  fullname String @default("")
  gender   String @default("")
  age      String @default("")

  // what brings you here
  visit          String[] @default([])
  visitOtherText String   @default("") @map("visit_other_text")

  // where you live, or where you are visiting from
  whereAt   String @default("") @map("where_at")
  ward      String @default("")
  wardOther String @default("") @map("ward_other")
  region    String @default("")
  country   String @default("")
  stay      String @default("")
  often     String @default("")

  // contact. dialCc is the ISO country, which is what the length rules key off.
  dialCc String @default("TZ") @map("dial_cc")
  dial   String @default("+255")
  phone  String @default("")
  email  String @default("")

  // studying or working
  occ        String @default("")
  school     String @default("")
  course     String @default("")
  year       String @default("")
  profession String @default("")

  // what you would like from us
  interest String[] @default([])

  // walk with God (membership path only)
  dob            String   @default("")
  saved          Boolean?
  savedYear      String   @default("") @map("saved_year")
  bapt           Boolean?
  baptYear       String   @default("") @map("bapt_year")
  holy           Boolean?
  prevChurch     Boolean? @map("prev_church")
  prevChurchName String   @default("") @map("prev_church_name")

  // family (membership path only)
  marital     String   @default("")
  marriedYear String   @default("") @map("married_year")
  kids        Boolean?
  children    String[] @default([])

  // where you would love to serve (membership path only)
  ministries    String[] @default([])
  otherMinistry String   @default("") @map("other_ministry")

  // the open-ended tail
  liked    String   @default("")
  /// Null until the question is put to them; false ends the form there.
  wantMore Boolean? @map("want_more")
  prayer   String   @default("")
  /// Retired: the flow no longer asks "anything else on your mind". Kept so
  /// the answers already given to it are not thrown away.
  comments String   @default("")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)

  person    Person?
  reminders RegistrationReminder[]

  @@index([status, updatedAt(sort: Desc)])
  @@map("registrations")
}

enum PersonStage {
  VISITOR
  NEW_CONVERT
  FOUNDATION_CLASS
  AWAITING_BAPTISM
  MEMBERSHIP_REVIEW
  CONFIRMED_MEMBER
}

/// Someone the church is caring for. Usually created with a registration; the
/// office can also add someone who never filled in the form.
model Person {
  id             String  @id @default(uuid(7)) @db.Uuid
  registrationId String? @unique @map("registration_id") @db.Uuid
  /// Copied from the registration while it is linked; typed in otherwise.
  fullName       String  @default("") @map("full_name") @db.VarChar(120)
  gender         String  @default("") @db.VarChar(20)
  ageGroup       String  @default("") @map("age_group") @db.VarChar(20)
  dial           String  @default("+255") @db.VarChar(6)
  phone          String  @default("") @db.VarChar(20)
  email          String  @default("") @db.VarChar(254)

  stage           PersonStage @default(VISITOR)
  /// Null = go by what they said on the form. Set = the office has confirmed it.
  saved           Boolean?
  savedSetById    String?     @map("saved_set_by_id") @db.Uuid
  savedSetAt      DateTime?   @map("saved_set_at") @db.Timestamptz(6)
  baptised        Boolean?
  baptisedSetById String?     @map("baptised_set_by_id") @db.Uuid
  baptisedSetAt   DateTime?   @map("baptised_set_at") @db.Timestamptz(6)

  /// The language they answered the registration form in, and are written
  /// to in (D22). Copied from the form while it is linked; the office may
  /// change it.
  lang            String    @default("en") @db.VarChar(2)
  /// They asked not to be sent messages: by replying STOP, through the office,
  /// or on the form. Nothing is sent to them while it is set.
  smsOptOut       Boolean   @default(false) @map("sms_opt_out")
  smsOptOutAt     DateTime? @map("sms_opt_out_at") @db.Timestamptz(6)
  /// 'reply' | 'office' | 'form' | 'outreach'
  smsOptOutSource String?   @map("sms_opt_out_source") @db.VarChar(10)

  /// How they came to be in People: 'FORM' (the registration form), 'OFFICE'
  /// (added by hand) or 'OUTREACH' (reached on a Saturday). Never changes.
  source String @default("FORM") @db.VarChar(10)

  memberNumber Int?      @map("member_number")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  registration Registration? @relation(fields: [registrationId], references: [id])

  stageEvents  PersonStageEvent[]
  notes        PersonNote[]
  applications MembershipApplication[]
  enrollments  FoundationEnrollment[]
  account      User?
  leaderships  DepartmentLeader[]
  departments  DepartmentMember[]
  messages     CommsRecipient[]

  outreachGroups    OutreachGroupMember[]
  outreachTeams     OutreachSessionTeamMember[]
  outreachReached   OutreachReached[]
  outreachTrainings OutreachTrainingAttendance[]
  interactions      PersonInteraction[]

  @@unique([memberNumber])
  @@index([stage])
  @@index([fullName])
  @@map("people")
}

/// Every move along the journey, so "when did she join the class" has an answer.
model PersonStageEvent {
  id        String       @id @default(uuid(7)) @db.Uuid
  personId  String       @map("person_id") @db.Uuid
  fromStage PersonStage? @map("from_stage")
  toStage   PersonStage  @map("to_stage")
  /// Null when the system moved them rather than a person.
  byId      String?      @map("by_id") @db.Uuid
  note      String?      @db.VarChar(300)
  at        DateTime     @default(now()) @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, at])
  @@map("person_stage_events")
}

enum InteractionKind {
  EVANGELISED
  CALL
  VISIT
  INVITED
  ATTENDED_SERVICE
  TRAINING
  REGISTERED
  CLASS_SESSION
  APPLIED
  CONFIRMED
  NOTE
}

/// Everything that happened with a person, from any portal, in order (D23):
/// evangelised on the 5th, called on the 7th, visited on the 12th, came on
/// the 20th. Written by every portal, never edited or deleted. `people.stage`
/// stays as the one-word summary of it, never a competing truth.
///
/// A summary is read by everyone who may see the person in any portal, so it
/// never carries what Membership keeps behind its sensitive permission.
model PersonInteraction {
  id        String          @id @default(uuid(7)) @db.Uuid
  personId  String          @map("person_id") @db.Uuid
  kind      InteractionKind
  /// When it happened, which is not always when it was written down.
  at        DateTime        @db.Timestamptz(6)
  /// The portal that recorded it, for the timeline's small labels.
  moduleKey String          @map("module_key") @db.VarChar(30)
  /// The staff account that recorded it, or null when the system did.
  byId      String?         @map("by_id") @db.Uuid
  /// One line in plain words: "Evangelised by Peter Mushi and John Laizer, Sombetini".
  summary   String          @db.VarChar(200)
  /// Whatever the recording portal wants back later: a session, an enrolment.
  meta      Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Erasing a person (the person:erase command) takes this with them.
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, at(sort: Desc)])
  @@index([kind, at(sort: Desc)])
  @@map("person_interactions")
}

enum PersonNoteKind {
  NOTE
  VISIT
  CALL
}

/// What the follow-up team did and what came of it. Sensitive: reading these
/// needs membership.people.read_sensitive.
model PersonNote {
  id        String         @id @default(uuid(7)) @db.Uuid
  personId  String         @map("person_id") @db.Uuid
  kind      PersonNoteKind @default(NOTE)
  body      String         @db.VarChar(2000)
  authorId  String         @map("author_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt(sort: Desc)])
  @@map("person_notes")
}

enum ApplicationStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONFIRMED
  WITHDRAWN
}

/// Asking to become a member, and what the pastors decided.
model MembershipApplication {
  id            String            @id @default(uuid(7)) @db.Uuid
  personId      String            @map("person_id") @db.Uuid
  status        ApplicationStatus @default(UNDER_REVIEW)
  /// 'FORM' when the registration asked to join, 'OFFICE' when entered here.
  source        String            @db.VarChar(10)
  submittedAt   DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  submittedById String?           @map("submitted_by_id") @db.Uuid
  reviewNote    String?           @map("review_note") @db.VarChar(1000)
  decidedById   String?           @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?         @map("decided_at") @db.Timestamptz(6)
  rejectReason  String?           @map("reject_reason") @db.VarChar(500)
  confirmedById String?           @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt(sort: Desc)])
  @@map("membership_applications")
}

/// A foundation class group: 'Thursday group', 'Saturday group'.
model FoundationGroup {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @db.VarChar(60)
  isActive Boolean @default(true) @map("is_active")

  enrollments FoundationEnrollment[]

  @@unique([name])
  @@map("foundation_groups")
}

/// One person in one group, once. Finishing or dropping out closes it.
model FoundationEnrollment {
  id          String    @id @default(uuid(7)) @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  droppedAt   DateTime? @map("dropped_at") @db.Timestamptz(6)

  person     Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  group      FoundationGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendance FoundationAttendance[]

  @@index([groupId])
  @@map("foundation_enrollments")
}

enum AttendanceMark {
  ATTENDED
  MISSED
}

/// One tick, for one session of one sign-up.
model FoundationAttendance {
  enrollmentId String         @map("enrollment_id") @db.Uuid
  sessionNo    Int            @map("session_no")
  mark         AttendanceMark
  markedById   String         @map("marked_by_id") @db.Uuid
  markedAt     DateTime       @default(now()) @map("marked_at") @db.Timestamptz(6)

  enrollment FoundationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, sessionNo])
  @@index([enrollmentId])
  @@map("foundation_attendance")
}

/// When someone was sent their registration link again, and how.
model RegistrationReminder {
  id             String   @id @default(uuid(7)) @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  /// 'COPY_LINK' | 'WHATSAPP' | later 'SMS'.
  channel        String   @db.VarChar(20)
  sentById       String   @map("sent_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("registration_reminders")
}

/// A part of the church's life: the praise team, the choir, Outreach (D28).
/// Kept by the administrators. A portal, where there is one, belongs to one.
model Department {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @unique @db.VarChar(80)
  description String    @default("") @db.VarChar(300)
  /// The portal this department has, if it has one. Switching a department
  /// portal on needs the department that owns it.
  moduleKey   String?   @unique @map("module_key") @db.VarChar(40)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Kept, never deleted: its history of leaders, members and messages stays.
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  leaders   DepartmentLeader[]
  members   DepartmentMember[]
  grants    CommsAudienceGrant[]
  templates CommsTemplate[]
  messages  CommsMessage[]
  schedules CommsSchedule[]

  @@map("departments")
}

/// Someone who leads a department. Named and ended only by an administrator,
/// and only a confirmed member can be named. Ended, never deleted, so who led
/// the choir in 2027 keeps an answer.
model DepartmentLeader {
  id           String    @id @default(uuid(7)) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  /// What the department calls them: 'Chairperson', 'Secretary'.
  title        String    @db.VarChar(60)
  addedById    String?   @map("added_by_id") @db.Uuid
  addedAt      DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  endedById    String?   @map("ended_by_id") @db.Uuid

  department Department @relation(fields: [departmentId], references: [id])
  /// Erasing a person (the person:erase command) takes this with them.
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([departmentId])
  @@map("department_leaders")
}

/// Someone in a department, added by its leaders. Anyone in People can be one.
model DepartmentMember {
  id           String    @id @default(uuid(7)) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  addedById    String?   @map("added_by_id") @db.Uuid
  addedAt      DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  endedById    String?   @map("ended_by_id") @db.Uuid

  department Department @relation(fields: [departmentId], references: [id])
  /// Erasing a person (the person:erase command) takes this with them.
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([departmentId])
  @@map("department_members")
}

/// Settings the office can change, with the defaults in code (probation days,
/// how many foundation sessions there are).
model Setting {
  key       String   @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([key])
  @@map("settings")
}

/// A key that lets the registration form call the public API. Read by a guard
/// before anything else, so it carries no permissions of its own.
model ApiClient {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @db.VarChar(80)
  /// 'REGISTRATION' today. A key is only good for the kind it was made for.
  kind       String    @db.VarChar(20)
  /// The first characters, so a key can be recognised in a list.
  keyPrefix  String    @map("key_prefix") @db.VarChar(12)
  keyHash    String    @unique @map("key_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@map("api_clients")
}

// ── Communications (Phase 7) ───────────────────────────────────────────────
// A message, template, beat or grant names its department by department_id;
// null means Communications itself (D21, D28). History is added to and never
// rewritten: the migration takes update and delete away from the application
// on what was sent, except the columns that move as sending proceeds.

/// A department may use this church-wide audience. Its own department never
/// needs one: its leaders can always reach it.
model CommsAudienceGrant {
  departmentId String   @map("department_id") @db.Uuid
  /// 'church.people', 'church.members', 'church.staff', 'membership.class'…
  audienceKey  String   @map("audience_key") @db.VarChar(60)
  grantedById  String?  @map("granted_by_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id])

  @@id([departmentId, audienceKey])
  @@map("comms_audience_grants")
}

enum TemplateStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  RETIRED
}

/// The words of a message, approved once and used many times. Changing an
/// approved one makes the next version; the old one keeps sending until the
/// new one is approved. Retired, never deleted.
model CommsTemplate {
  id            String         @id @default(uuid(7)) @db.Uuid
  /// Every version of the same words shares it.
  familyId      String         @map("family_id") @db.Uuid
  version       Int            @default(1)
  departmentId  String?        @map("department_id") @db.Uuid
  name          String         @db.VarChar(80)
  status        TemplateStatus @default(DRAFT)
  /// The blanks its bodies use, worked out from them: ['first_name', 'date'].
  fields        String[]       @default([])
  supersedesId  String?        @map("supersedes_id") @db.Uuid
  createdById   String         @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedById String?        @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime?      @map("submitted_at") @db.Timestamptz(6)
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?        @map("decision_note") @db.VarChar(500)

  department Department?         @relation(fields: [departmentId], references: [id])
  bodies     CommsTemplateBody[]
  messages   CommsMessage[]

  @@unique([familyId, version])
  @@index([departmentId, status])
  @@map("comms_templates")
}

/// One body per language. One approval covers all of them (D22).
model CommsTemplateBody {
  templateId String @map("template_id") @db.Uuid
  /// 'en' | 'sw' | 'fr'
  lang       String @db.VarChar(2)
  /// Six segments at most.
  body       String @db.VarChar(918)

  template CommsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, lang])
  @@map("comms_template_bodies")
}

enum MessageStatus {
  SCHEDULED
  SENDING
  SENT
  PARTIAL
  FAILED
  CANCELLED
}

/// One send: now, at a set time, or from a beat.
model CommsMessage {
  id             String        @id @default(uuid(7)) @db.Uuid
  departmentId   String?       @map("department_id") @db.Uuid
  audienceKey    String        @map("audience_key") @db.VarChar(60)
  audienceParams Json          @default("{}") @map("audience_params")
  /// What the audience was called when it was sent: 'Everyone in Praise team'.
  audienceName   String        @map("audience_name") @db.VarChar(200)
  templateId     String?       @map("template_id") @db.Uuid
  scheduleId     String?       @map("schedule_id") @db.Uuid
  /// The words per language, as sent, before each person's blanks.
  bodies         Json
  /// What the sender typed into the blanks: event_name, date, time, venue.
  fields         Json          @default("{}")
  status         MessageStatus @default(SENDING)
  scheduledFor   DateTime?     @map("scheduled_for") @db.Timestamptz(6)
  recipientCount Int           @default(0) @map("recipient_count")
  skippedCount   Int           @default(0) @map("skipped_count")
  segments       Int           @default(0)
  /// Segments × the price per segment when it was sent.
  cost           Decimal       @default(0) @db.Decimal(14, 2)
  /// Null when a beat sent it.
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?     @map("finished_at") @db.Timestamptz(6)
  cancelledById  String?       @map("cancelled_by_id") @db.Uuid

  department Department?      @relation(fields: [departmentId], references: [id])
  template   CommsTemplate?   @relation(fields: [templateId], references: [id])
  schedule   CommsSchedule?   @relation(fields: [scheduleId], references: [id])
  recipients CommsRecipient[]

  @@index([createdAt(sort: Desc)])
  @@index([departmentId, createdAt(sort: Desc)])
  @@index([status])
  @@map("comms_messages")
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  SKIPPED_OPT_OUT
  SKIPPED_NO_PHONE
  SKIPPED_DUPLICATE
}

/// The outbox: one row per number, which is also the delivery record.
model CommsRecipient {
  id                String          @id @default(uuid(7)) @db.Uuid
  messageId         String          @map("message_id") @db.Uuid
  /// Erasing a person takes their rows with them (person:erase).
  personId          String?         @map("person_id") @db.Uuid
  userId            String?         @map("user_id") @db.Uuid
  /// E.164, '+255712345678'. Empty when they had no usable number.
  phone             String          @db.VarChar(20)
  lang              String          @db.VarChar(2)
  /// Exactly what they were sent, blanks filled and the way to stop added.
  body              String          @db.VarChar(1200)
  segments          Int             @default(1)
  status            RecipientStatus @default(PENDING)
  attempts          Int             @default(0)
  nextAttemptAt     DateTime        @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  providerMessageId String?         @map("provider_message_id") @db.VarChar(200)
  lastError         String?         @map("last_error") @db.VarChar(500)
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?       @map("delivered_at") @db.Timestamptz(6)

  message CommsMessage @relation(fields: [messageId], references: [id])
  person  Person?      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([messageId])
  @@index([phone])
  @@index([providerMessageId])
  @@map("comms_recipients")
}

/// A beat: the same message on a rhythm, from one of two or more templates.
model CommsSchedule {
  id             String    @id @default(uuid(7)) @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  name           String    @db.VarChar(80)
  audienceKey    String    @map("audience_key") @db.VarChar(60)
  audienceParams Json      @default("{}") @map("audience_params")
  audienceName   String    @map("audience_name") @db.VarChar(200)
  templateIds    String[]  @map("template_ids") @db.Uuid
  fields         Json      @default("{}")
  /// 1 = Monday … 7 = Sunday.
  daysOfWeek     Int[]     @map("days_of_week")
  /// 'HH:MM', in the church's timezone.
  timeOfDay      String    @map("time_of_day") @db.VarChar(5)
  jitterMinutes  Int       @default(0) @map("jitter_minutes")
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(6)
  /// Why the last run did not send, in words, if it did not.
  lastError      String?   @map("last_error") @db.VarChar(500)
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Kept, never deleted: the messages it sent are what the church said.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  department Department?    @relation(fields: [departmentId], references: [id])
  messages   CommsMessage[]

  @@index([isActive, nextRunAt])
  @@map("comms_schedules")
}

/// A number that asked to be left alone, or that the carrier says is dead.
model CommsBlockedNumber {
  /// E.164.
  phone     String   @id @db.VarChar(20)
  /// 'replied STOP', 'invalid number', 'by hand'
  reason    String   @db.VarChar(60)
  personId  String?  @map("person_id") @db.Uuid
  blockedAt DateTime @default(now()) @map("blocked_at") @db.Timestamptz(6)
  note      String?  @db.VarChar(200)

  @@map("comms_blocked_numbers")
}

/// Whatever Beem sent us — replies and delivery reports — exactly as it came.
model CommsInbound {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// 'reply' | 'delivery'
  kind       String   @db.VarChar(10)
  phone      String   @default("") @db.VarChar(20)
  body       String   @default("") @db.VarChar(1000)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  /// 'opted out', 'delivered', 'failed', 'kept', 'not understood'
  action     String   @default("") @db.VarChar(40)
  raw        Json

  @@index([receivedAt(sort: Desc)])
  @@map("comms_inbound")
}

/// The Beem account (D26). Exactly one row, a check constraint says so. The
/// key and secret are sealed with BEEM_SETTINGS_KEY and never leave the API.
model CommsBeemAccount {
  id           Int      @id @default(1)
  apiKeyEnc    Bytes    @map("api_key_enc")
  secretKeyEnc Bytes    @map("secret_key_enc")
  /// The last four characters of the key, so a person can tell which one is saved.
  keyLast4     String   @map("key_last4") @db.VarChar(4)
  /// The name a message comes from, as Beem registered it. At most 11 characters.
  senderId     String   @map("sender_id") @db.VarChar(11)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?  @map("updated_by_id") @db.Uuid

  @@map("comms_beem_account")
}

// ── Outreach (Phase 8) ─────────────────────────────────────────────────────
// The team is the Outreach department's leaders and members (D28), so there
// is no team table here: these tables point at people. Someone reached is a
// row in `people` (D23), and what happened with them is on their timeline,
// `person_interactions`. Sessions and groups are closed or switched off,
// never deleted, so last year's Saturdays keep their answer.

/// A standing partnership: two or three of the team who usually go out together.
model OutreachGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(60)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members OutreachGroupMember[]
  teams   OutreachSessionTeam[]

  @@map("outreach_groups")
}

model OutreachGroupMember {
  groupId  String @map("group_id") @db.Uuid
  personId String @map("person_id") @db.Uuid

  group  OutreachGroup @relation(fields: [groupId], references: [id])
  /// Erasing a person (the person:erase command) takes this with them.
  person Person        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([groupId, personId])
  @@index([personId])
  @@map("outreach_group_members")
}

enum OutreachSessionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

/// One Saturday.
model OutreachSession {
  id          String                @id @default(uuid(7)) @db.Uuid
  heldOn      DateTime              @map("held_on") @db.Date
  title       String                @default("") @db.VarChar(80)
  status      OutreachSessionStatus @default(PLANNED)
  notes       String                @default("") @db.VarChar(2000)
  createdById String                @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  teams   OutreachSessionTeam[]
  reached OutreachReached[]

  @@index([heldOn(sort: Desc)])
  @@map("outreach_sessions")
}

/// A team sent to one area on that Saturday. Its people may differ from the
/// standing group it started from: partners get swapped on the day.
model OutreachSessionTeam {
  id           String  @id @default(uuid(7)) @db.Uuid
  sessionId    String  @map("session_id") @db.Uuid
  groupId      String? @map("group_id") @db.Uuid
  area         String  @db.VarChar(80)
  /// People spoken to without taking details. Those recorded are counted, not typed.
  spokenToOnly Int     @default(0) @map("spoken_to_only")
  notes        String  @default("") @db.VarChar(1000)

  session OutreachSession             @relation(fields: [sessionId], references: [id])
  group   OutreachGroup?              @relation(fields: [groupId], references: [id])
  members OutreachSessionTeamMember[]
  reached OutreachReached[]

  @@index([sessionId])
  @@map("outreach_session_teams")
}

model OutreachSessionTeamMember {
  teamId   String @map("team_id") @db.Uuid
  personId String @map("person_id") @db.Uuid

  team   OutreachSessionTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Erasing a person (the person:erase command) takes this with them.
  person Person              @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([teamId, personId])
  @@index([personId])
  @@map("outreach_session_team_members")
}

/// A person reached on a Saturday. Their own details live in `people`; this
/// row says when, where and by whom. Only the area, the note and whether they
/// still need following up change afterwards.
model OutreachReached {
  id            String   @id @default(uuid(7)) @db.Uuid
  personId      String   @map("person_id") @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  teamId        String?  @map("team_id") @db.Uuid
  reachedOn     DateTime @map("reached_on") @db.Date
  area          String   @default("") @db.VarChar(80)
  /// The people who spoke to them: the team, not staff accounts. No foreign
  /// key, so person:erase takes an erased person out of these by hand.
  reachedByIds  String[] @default([]) @map("reached_by_ids") @db.Uuid
  needsFollowUp Boolean  @default(true) @map("needs_follow_up")
  note          String   @default("") @db.VarChar(1000)
  recordedById  String   @map("recorded_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Erasing a person (the person:erase command) takes this with them.
  person  Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  session OutreachSession?     @relation(fields: [sessionId], references: [id])
  team    OutreachSessionTeam? @relation(fields: [teamId], references: [id])

  @@index([reachedOn(sort: Desc)])
  @@index([personId])
  @@index([sessionId])
  @@map("outreach_reached")
}

/// A Friday training.
model OutreachTraining {
  id          String   @id @default(uuid(7)) @db.Uuid
  topic       String   @db.VarChar(120)
  trainer     String   @default("") @db.VarChar(80)
  heldAt      DateTime @map("held_at") @db.Timestamptz(6)
  venue       String   @default("") @db.VarChar(80)
  notes       String   @default("") @db.VarChar(2000)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attendance OutreachTrainingAttendance[]

  @@index([heldAt(sort: Desc)])
  @@map("outreach_trainings")
}

/// Who came to a training. The same marks the foundation class uses.
model OutreachTrainingAttendance {
  trainingId String         @map("training_id") @db.Uuid
  personId   String         @map("person_id") @db.Uuid
  mark       AttendanceMark
  markedById String         @map("marked_by_id") @db.Uuid
  markedAt   DateTime       @default(now()) @map("marked_at") @db.Timestamptz(6)

  training OutreachTraining @relation(fields: [trainingId], references: [id])
  /// Erasing a person (the person:erase command) takes this with them.
  person   Person           @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([trainingId, personId])
  @@index([personId])
  @@map("outreach_training_attendance")
}
