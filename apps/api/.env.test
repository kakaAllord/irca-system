# Test settings, committed: local-only credentials for the irca_test database.
# Used whenever NODE_ENV=test (vitest sets it), so tests never touch irca_dev.
NODE_ENV=test
PORT=4000

# Feature modules: the irca_app role. Row-level security limits it to one church.
DATABASE_URL=postgresql://irca_app:app_local_pw@localhost:5432/irca_test
# Core code only (sign-in, sessions, audit, jobs): the irca_core role, sees every church.
DATABASE_URL_CORE=postgresql://irca_core:core_local_pw@localhost:5432/irca_test
# Impersonated requests: the irca_readonly role.
DATABASE_URL_READONLY=postgresql://irca_readonly:ro_local_pw@localhost:5432/irca_test
# Migrations only: the irca_owner role. On Neon, the direct (non-pooler) host.
DIRECT_DATABASE_URL=postgresql://irca_owner:owner_local_pw@localhost:5432/irca_test

# Where the portal lives: links in emails, and the Origin check on writes.
PORTAL_ORIGIN=http://localhost:3000

SESSION_COOKIE_NAME=irca_session        # production: __Host-irca_session
SESSION_ABSOLUTE_HOURS=168              # sign in again after 7 days, however active
SESSION_IDLE_HOURS=12                   # or after 12 hours unused
TRUST_PROXY=1                           # proxies in front of the API (portal rewrite, host load balancer)
LOG_LEVEL=error

# Tests read the emails back instead of sending them.
EMAIL_PROVIDER=memory
